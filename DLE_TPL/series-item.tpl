<!-- Series Card Component - Based on Figma Design -->
<article class="series-item">
    <a href="{link-category}" class="series-link">
        <div class="series-cover">
            [not-category]
            <img src="{icon}" alt="{category}" class="series-img" loading="lazy">
            [/not-category]
        </div>
        <div class="series-info">
            <h3 class="series-title">{category}</h3>
            <p class="series-count">{news-num} выпусков →</p>
        </div>
    </a>
</article>
