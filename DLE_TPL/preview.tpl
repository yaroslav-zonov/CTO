[short-preview]
<div class="preview-shell">
	<div class="preview-card">
		<header class="preview-header">
			<h1 class="preview-title">{title}</h1>
		</header>
		<div class="preview-body">
			{short-story}
		</div>
	</div>
</div>
[/short-preview]
[full-preview]
<div class="preview-shell">
	<div class="preview-card">
		<header class="preview-header">
			<h1 class="preview-title">{title}</h1>
		</header>
		<div class="preview-body">
			{full-story}
		</div>
	</div>
</div>
[/full-preview]
[static-preview]
<div class="preview-shell">
	<div class="preview-card">
		<header class="preview-header">
			<h1 class="preview-title">{description}</h1>
		</header>
		<div class="preview-body">
			{static}
		</div>
	</div>
</div>
[/static-preview]
