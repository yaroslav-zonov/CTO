<article class="flex flex-col gap-2 group shrink-0">
    <a href="{full-link}" class="relative w-full overflow-hidden pb-[150%] block">
        <img
            src="{image-1}"
            alt="{title}"
            class="absolute top-0 left-0 w-full h-full object-cover object-center"
            loading="lazy"
        />
    </a>
    <a href="{full-link}" class="no-underline">
        <p class="font-normal text-sm leading-4 text-foreground transition-opacity group-hover:opacity-90">{title limit="80"}</p>
    </a>
</article>
