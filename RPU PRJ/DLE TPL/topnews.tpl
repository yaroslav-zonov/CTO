<a class="flex gap-3 group p-2 rounded-lg hover:bg-secondary transition-colors" href="{link}">
	<div class="flex-shrink-0 w-16 h-16 rounded overflow-hidden">
		<img src="{image-1}" alt="{title}" class="w-full h-full object-cover" />
	</div>
	<div class="flex-1 min-w-0">
		<p class="text-sm font-medium text-foreground group-hover:opacity-90 line-clamp-2 transition-opacity">{title limit="45"}</p>
	</div>
</a>
